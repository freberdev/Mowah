// Resources for Mowah: icons, manifest, version info and the main window layout.
//
// Every control ID here is mirrored in src/win/ids.rs. All visible text is ASCII
// placeholder text; the Swedish wording is set from Rust when the window opens,
// so this file never depends on how a resource compiler reads non-ASCII characters.

#include <windows.h>

#define IDI_APP             1
#define IDI_PAUSED          2
#define IDD_MAIN            100

#define IDC_STATUS          1001
#define IDC_LAST_ACTION     1002
#define IDC_PAUSE           1003
#define IDC_GRP_ACTIVITY    1010
#define IDC_LBL_METHOD      1011
#define IDC_METHOD          1012
#define IDC_LBL_IDLE        1013
#define IDC_IDLE            1014
#define IDC_LBL_IDLE_UNIT   1015
#define IDC_LBL_INTERVAL    1016
#define IDC_INTERVAL_MIN    1017
#define IDC_LBL_DASH        1018
#define IDC_INTERVAL_MAX    1019
#define IDC_LBL_INT_UNIT    1020
#define IDC_CLICK           1021
#define IDC_GRP_AWAKE       1030
#define IDC_PREVENT_SLEEP   1031
#define IDC_KEEP_DISPLAY    1032
#define IDC_GRP_SCHEDULE    1040
#define IDC_SCHEDULE        1041
#define IDC_SCHEDULE_FROM   1042
#define IDC_LBL_AND         1043
#define IDC_SCHEDULE_TO     1044
#define IDC_GRP_PROGRAM     1050
#define IDC_AUTOSTART       1051
#define IDC_START_MINIMIZED 1052
#define IDC_CLOSE_TO_TRAY   1053
#define IDC_JOKE            1060

IDI_APP     ICON "mowah.ico"
IDI_PAUSED  ICON "mowah-paused.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "mowah.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Mowah"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "Mowah"
            VALUE "OriginalFilename", "Mowah.exe"
            VALUE "ProductName",      "Mowah"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_MAIN DIALOGEX 0, 0, 262, 288
STYLE DS_SETFONT | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Mowah"
CLASS "MowahMainWindow"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "", IDC_STATUS, 10, 9, 182, 9, SS_NOPREFIX
    LTEXT           "", IDC_LAST_ACTION, 10, 20, 182, 9, SS_NOPREFIX
    PUSHBUTTON      "Pause", IDC_PAUSE, 196, 9, 58, 16

    GROUPBOX        "Activity", IDC_GRP_ACTIVITY, 7, 34, 248, 80
    LTEXT           "Method", IDC_LBL_METHOD, 15, 49, 72, 9
    COMBOBOX        IDC_METHOD, 90, 47, 156, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Run when idle for", IDC_LBL_IDLE, 15, 66, 72, 9
    EDITTEXT        IDC_IDLE, 90, 64, 32, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "seconds", IDC_LBL_IDLE_UNIT, 126, 66, 60, 9
    LTEXT           "Repeat every", IDC_LBL_INTERVAL, 15, 82, 72, 9
    EDITTEXT        IDC_INTERVAL_MIN, 90, 80, 32, 12, ES_NUMBER | ES_AUTOHSCROLL
    CTEXT           "-", IDC_LBL_DASH, 123, 82, 10, 9
    EDITTEXT        IDC_INTERVAL_MAX, 134, 80, 32, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "seconds", IDC_LBL_INT_UNIT, 170, 82, 60, 9
    AUTOCHECKBOX    "Left click too", IDC_CLICK, 15, 98, 232, 10

    GROUPBOX        "Keep awake", IDC_GRP_AWAKE, 7, 118, 248, 40
    AUTOCHECKBOX    "Prevent sleep", IDC_PREVENT_SLEEP, 15, 130, 232, 10
    AUTOCHECKBOX    "Keep display on", IDC_KEEP_DISPLAY, 15, 143, 232, 10

    GROUPBOX        "Schedule", IDC_GRP_SCHEDULE, 7, 162, 248, 28
    AUTOCHECKBOX    "Only Mon-Fri between", IDC_SCHEDULE, 15, 174, 96, 10
    EDITTEXT        IDC_SCHEDULE_FROM, 114, 173, 30, 12, ES_AUTOHSCROLL
    CTEXT           "and", IDC_LBL_AND, 146, 175, 20, 9
    EDITTEXT        IDC_SCHEDULE_TO, 168, 173, 30, 12, ES_AUTOHSCROLL

    GROUPBOX        "Program", IDC_GRP_PROGRAM, 7, 194, 248, 54
    AUTOCHECKBOX    "Start with Windows", IDC_AUTOSTART, 15, 206, 232, 10
    AUTOCHECKBOX    "Start minimized", IDC_START_MINIMIZED, 15, 219, 232, 10
    AUTOCHECKBOX    "Close to tray", IDC_CLOSE_TO_TRAY, 15, 232, 232, 10

    LTEXT           "", IDC_JOKE, 10, 254, 244, 28, SS_NOPREFIX
END
