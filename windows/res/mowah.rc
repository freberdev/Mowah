// Resources for Mowah: icons, manifest, version info and the main window layout.
//
// Every control ID here is mirrored in src/win/ids.rs. All visible text is ASCII
// placeholder text; the wording, in Swedish or English, is set from Rust when the
// window opens, so this file never depends on how a resource compiler reads
// non-ASCII characters.
//
// The label column is as wide as the longest label in either language needs.
//
// The version numbers, company name and copyright line come from mowah_build.h,
// which build.rs writes from Cargo.toml before this file is compiled.

#include <windows.h>
#include "mowah_build.h"

#define IDI_APP             1
#define IDI_PAUSED          2
#define IDD_MAIN            100

#define IDC_STATUS          1001
#define IDC_LAST_ACTION     1002
#define IDC_PAUSE           1003
#define IDC_GRP_ACTIVITY    1010
#define IDC_LBL_METHOD      1011
#define IDC_METHOD          1012
#define IDC_LBL_IDLE        1013
#define IDC_IDLE            1014
#define IDC_LBL_IDLE_UNIT   1015
#define IDC_LBL_INTERVAL    1016
#define IDC_INTERVAL_MIN    1017
#define IDC_LBL_DASH        1018
#define IDC_INTERVAL_MAX    1019
#define IDC_LBL_INT_UNIT    1020
#define IDC_CLICK           1021
#define IDC_LBL_CIRCLE      1022
#define IDC_CIRCLE          1023
#define IDC_LBL_CIRCLE_UNIT 1024
#define IDC_GRP_AWAKE       1030
#define IDC_PREVENT_SLEEP   1031
#define IDC_KEEP_DISPLAY    1032
#define IDC_GRP_SCHEDULE    1040
#define IDC_SCHEDULE        1041
#define IDC_SCHEDULE_FROM   1042
#define IDC_LBL_AND         1043
#define IDC_SCHEDULE_TO     1044
#define IDC_GRP_PROGRAM     1050
#define IDC_AUTOSTART       1051
#define IDC_START_MINIMIZED 1052
#define IDC_CLOSE_TO_TRAY   1053
#define IDC_LBL_LANGUAGE    1054
#define IDC_LANGUAGE        1055
#define IDC_FOOTER          1060

IDI_APP     ICON "mowah.ico"
IDI_PAUSED  ICON "mowah-paused.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "mowah.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     MOWAH_VERSION_NUMBERS
PRODUCTVERSION  MOWAH_VERSION_NUMBERS
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      MOWAH_COMPANY
            VALUE "FileDescription",  "Mowah"
            VALUE "FileVersion",      MOWAH_VERSION_TEXT
            VALUE "InternalName",     "Mowah"
            VALUE "LegalCopyright",   MOWAH_COPYRIGHT
            VALUE "OriginalFilename", "Mowah.exe"
            VALUE "ProductName",      "Mowah"
            VALUE "ProductVersion",   MOWAH_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_MAIN DIALOGEX 0, 0, 262, 303
STYLE DS_SETFONT | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Mowah"
CLASS "MowahMainWindow"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "", IDC_STATUS, 10, 9, 182, 9, SS_NOPREFIX
    LTEXT           "", IDC_LAST_ACTION, 10, 20, 182, 9, SS_NOPREFIX
    PUSHBUTTON      "Pause", IDC_PAUSE, 196, 9, 58, 16

    GROUPBOX        "Activity", IDC_GRP_ACTIVITY, 7, 34, 248, 96
    LTEXT           "Method", IDC_LBL_METHOD, 15, 49, 92, 9
    COMBOBOX        IDC_METHOD, 110, 47, 136, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Circle size", IDC_LBL_CIRCLE, 15, 66, 92, 9
    EDITTEXT        IDC_CIRCLE, 110, 64, 32, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "pixels", IDC_LBL_CIRCLE_UNIT, 146, 66, 60, 9
    LTEXT           "Start after being idle for", IDC_LBL_IDLE, 15, 82, 92, 9
    EDITTEXT        IDC_IDLE, 110, 80, 32, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "seconds", IDC_LBL_IDLE_UNIT, 146, 82, 60, 9
    LTEXT           "Repeat every", IDC_LBL_INTERVAL, 15, 98, 92, 9
    EDITTEXT        IDC_INTERVAL_MIN, 110, 96, 32, 12, ES_NUMBER | ES_AUTOHSCROLL
    CTEXT           "-", IDC_LBL_DASH, 143, 98, 10, 9
    EDITTEXT        IDC_INTERVAL_MAX, 154, 96, 32, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "seconds", IDC_LBL_INT_UNIT, 190, 98, 58, 9
    AUTOCHECKBOX    "Also left-click", IDC_CLICK, 15, 114, 232, 10

    GROUPBOX        "Keep awake", IDC_GRP_AWAKE, 7, 134, 248, 40
    AUTOCHECKBOX    "Prevent sleep", IDC_PREVENT_SLEEP, 15, 146, 232, 10
    AUTOCHECKBOX    "Keep display on", IDC_KEEP_DISPLAY, 15, 159, 232, 10

    GROUPBOX        "Schedule", IDC_GRP_SCHEDULE, 7, 178, 248, 28
    AUTOCHECKBOX    "Only Mon-Fri between", IDC_SCHEDULE, 15, 190, 96, 10
    EDITTEXT        IDC_SCHEDULE_FROM, 114, 189, 30, 12, ES_AUTOHSCROLL
    CTEXT           "and", IDC_LBL_AND, 146, 191, 20, 9
    EDITTEXT        IDC_SCHEDULE_TO, 168, 189, 30, 12, ES_AUTOHSCROLL

    GROUPBOX        "Program", IDC_GRP_PROGRAM, 7, 210, 248, 72
    AUTOCHECKBOX    "Start with Windows", IDC_AUTOSTART, 15, 222, 232, 10
    AUTOCHECKBOX    "Start minimized", IDC_START_MINIMIZED, 15, 235, 232, 10
    AUTOCHECKBOX    "Close to tray", IDC_CLOSE_TO_TRAY, 15, 248, 232, 10
    LTEXT           "Language", IDC_LBL_LANGUAGE, 15, 265, 92, 9
    COMBOBOX        IDC_LANGUAGE, 110, 263, 136, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    CTEXT           "", IDC_FOOTER, 7, 288, 248, 9, SS_NOPREFIX
END
